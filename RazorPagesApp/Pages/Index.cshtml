@page
@model MyRazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            background-color: #f4f1e5;
            font-family: sans-serif;
        }

        .container-custom {
            background: #ffffff;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }

        .btn {
            border: none;
            transition: background-color 0.2s ease-in-out;
        }

        .btn-green {
            background-color: #c480c2 !important;
            color: white !important;
        }

        .btn-brown {
            background-color: #795548 !important;
            color: white !important;
        }

        .btn-red {
            background-color: #c595cb !important;
            color: white !important;
        }

        .table-header {
            background-color: #a0769f;
            color: white;
        }

        .form-label {
            color: #832299;
            font-weight: bold;
        }

        .form-control {
            border-radius: 5px;
        }

        .pagination .page-item.active .page-link {
            background-color: #c480c2;
            border-color: #c480c2;
            color: white;
        }

        .pagination .page-link {
            color: #926390;
        }

        .pagination .page-item.disabled .page-link {
            color: #c595cb;
            background-color: #e9ecef;
        }

        .alert-dismissible {
            margin-top: 15px;
        }

        .selected-column {
            background-color: #d1ecf1 !important;
        }

        th[data-column] {
            cursor: pointer;
        }
    </style>
</head>

<body>
    <div class="container mt-4">

        <div class="d-flex justify-content-end mb-3">
            <form method="get" asp-page="Logout">
                <button type="submit" class="btn btn-red">Logout</button>
            </form>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row">
            <div class="col-md-4">
                <div class="container-custom">
                    <h3 style="color: #8a5e89;">@(Model.EditId.HasValue ? "Edit Class" : "Add Class")</h3>

                    <form method="post" asp-page-handler="Add">
                        <input type="hidden" asp-for="EditId" />
                        <input type="hidden" asp-for="Filter" />
                        <input type="hidden" asp-for="PageNumber" />

                        <div class="mb-3">
                            <label asp-for="ClassInfo.ClassName" class="form-label">Class Name</label>
                            <input type="text" class="form-control" asp-for="ClassInfo.ClassName" />
                            <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ClassInfo.StudentCount" class="form-label">Student Count</label>
                            <input type="number" class="form-control" asp-for="ClassInfo.StudentCount" />
                            <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ClassInfo.Description" class="form-label">Description</label>
                            <input type="text" class="form-control" asp-for="ClassInfo.Description" />
                            <span asp-validation-for="ClassInfo.Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ClassInfo.IsActive" class="form-label">Is Active</label>
                            <input type="checkbox" class="form-check-input" asp-for="ClassInfo.IsActive" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-green">
                                @(Model.EditId.HasValue ? "Update" : "Add")
                            </button>
                            <a asp-page="./Index" asp-route-filter="@Model.Filter"
                               asp-route-pageNumber="@Model.PageNumber" class="btn btn-brown">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-md-8">
                <div class="container-custom">
                    <h3 style="color: rgb(174, 96, 171);">Class List</h3>

                    <form method="get" asp-page="./Index" class="mb-3" id="filterForm">
                        <input type="text" class="form-control" asp-for="Filter"
                               placeholder="Filter by Name or Description" id="filterInput" />
                    </form>

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover">
                            <thead>
                                <tr class="table-header">
                                    <th data-column="Id">ID</th>
                                    <th data-column="ClassName">Class Name</th>
                                    <th data-column="StudentCount">Student Count</th>
                                    <th data-column="Description">Description</th>
                                    <th data-column="IsActive">Active</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DisplayList.Any())
                                {
                                    @foreach (var item in Model.DisplayList)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>@item.ClassName</td>
                                            <td>@item.StudentCount</td>
                                            <td>@item.Description</td>
                                            <td>@(item.IsActive ? "Yes" : "No")</td>
                                            <td class="action-buttons d-flex">
                                                <form method="post" asp-page-handler="Edit" class="me-1">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" asp-for="Filter" />
                                                    <input type="hidden" asp-for="PageNumber" />
                                                    <button type="submit" class="btn btn-brown btn-sm">Edit</button>
                                                </form>
                                                <form method="post" asp-page-handler="Delete"
                                                      onsubmit="return confirm('Are you sure?');">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" asp-for="Filter" />
                                                    <input type="hidden" asp-for="PageNumber" />
                                                    <button type="submit" class="btn btn-red btn-sm">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center">No classes found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="text-end mt-3">
                        <form method="post" asp-page-handler="ExportJson">
                            <input type="hidden" asp-for="Filter" />
                            <input type="hidden" asp-for="PageNumber" />
                            <input type="hidden" name="selectedColumns" id="selectedColumnsInput" />
                            <button type="submit" class="btn btn-green">Export JSON</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectedColumns = new Set();
            const columnHeaders = document.querySelectorAll('th[data-column]');
            const table = document.querySelector('table');

            columnHeaders.forEach(th => {
                th.addEventListener('click', function () {
                    const column = this.dataset.column;
                    const columnIndex = Array.from(this.parentElement.children).indexOf(this);

                    this.classList.toggle('selected-column');

                    const rows = table.querySelectorAll('tbody tr');
                    rows.forEach(row => {
                        const cell = row.children[columnIndex];
                        if (cell) cell.classList.toggle('selected-column');
                    });

                    if (selectedColumns.has(column)) {
                        selectedColumns.delete(column);
                    } else {
                        selectedColumns.add(column);
                    }

                    document.getElementById('selectedColumnsInput').value =
                        Array.from(selectedColumns).join(',');
                });
            });

            const filterInput = document.getElementById('filterInput');
            let timeoutId;

            if (filterInput) {
                filterInput.addEventListener('input', function () {
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => {
                        document.getElementById('filterForm').submit();
                    }, 800);
                });
            }
        });
    </script>
</body>
</html>