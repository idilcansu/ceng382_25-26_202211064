@page
@model RazorPagesApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Information";
}

<div class="container">
    <div class="row">
        <!-- Form Section -->
        <div class="col-md-6">
            <h2>Edit Class Information</h2>
            <form method="post">
                <div class="form-group">
                    <label for="ClassName">Class Name:</label>
                    <input type="text" id="ClassName" asp-for="ClassInfo.ClassName" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="StudentCount">Student Count:</label>
                    <input type="number" id="StudentCount" asp-for="ClassInfo.StudentCount" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="Description">Description:</label>
                    <textarea id="Description" asp-for="ClassInfo.Description" class="form-control"></textarea>
                </div>

                <button type="submit" class="btn btn-primary mt-3">Add Class</button>
            </form>
        </div>

        <!-- Class List Section -->
        <div class="col-md-6">
            <h3>Class List</h3>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var classItem in RazorPagesApp.Pages.IndexModel.ClassList)
                    {
                        <tr>
                            <td>@classItem.Id</td>
                            <td>@classItem.ClassName</td>
                            <td>@classItem.StudentCount</td>
                            <td>@classItem.Description</td>
                            <td>
                                <form method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-warning" asp-page-handler="Add" asp-route-id="@classItem.Id">Add</button>
                                    <button type="submit" class="btn btn-danger" asp-page-handler="Delete" asp-route-id="@classItem.Id">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>